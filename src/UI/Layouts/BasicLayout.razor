@namespace UI.Layouts
@using UI.Interfaces.SignalR
@using UI.Components.Shared
@inherits LayoutComponentBase
@inject INotificationSignalRService NotificationSignalRService
@inject NavigationManager Navigation

<AntDesign.ProLayout.BasicLayout 
    Logo="@("pro_icon.svg")"
    MenuData="_menuData"
    MenuAccordion
    @bind-Collapsed="collapsed">
    <HeaderContentRender>
        <Space Size="@("24")">
            <SpaceItem>
                <Icon Class="action" Type="@(collapsed?"menu-unfold":"menu-fold")" OnClick="Toggle" />
            </SpaceItem>
            <SpaceItem>
                <Icon Class="action" Type="reload" Theme="@IconThemeType.Outline" OnClick="Reload" />
            </SpaceItem>
        </Space>
    </HeaderContentRender>
    <RightContentRender>
    </RightContentRender>
    <ChildContent>
        <NotificationToast 
            IsVisible=@showNotification
            Message=@notificationMessage
            NotificationType=@notificationType
            OnClick=@(() => Navigation.NavigateTo("/notifications"))
            OnClose=@HideNotification />
        @Body
    </ChildContent>
    <FooterRender>
        <FooterView Copyright="2025 bezshumu" Links="Links"></FooterView>
    </FooterRender>
</AntDesign.ProLayout.BasicLayout>

<SettingDrawer />