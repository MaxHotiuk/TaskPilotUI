@page "/login"
@using UI.Interfaces.Services
@using UI.Models
@using AntDesign

<div class="login-container">
    <div class="login-content">
        <Card class="login-card" Title="@UI.Resources.I18n.SignInToTaskPilot">
            <div class="login-header">
                <Avatar Size=@AvatarSize.Large Icon="user" style="margin-bottom: 16px;" />
                <Title Level="3">@UI.Resources.I18n.WelcomeToTaskPilot</Title>
                <Text Type=@TextElementType.Secondary>
                    @UI.Resources.I18n.SignInWithMicrosoftDescription
                </Text>
            </div>

            @if (_isLoading)
            {
                <div class="login-loading">
                <Spin Size=@SpinSize.Large Tip="@UI.Resources.I18n.SigningYouIn">
                        <div style="height: 100px;"></div>
                    </Spin>
                </div>
            }
            else if (_error != null)
            {
                    <Alert
                    Type=@AlertType.Error
                    Message="@UI.Resources.I18n.AuthenticationError"
                    Description=@_error
                    ShowIcon=@true
                    Closable=@true
                    OnClose=@(() => _error = null)
                    Style="margin-bottom: 24px;" />
            }

            <div class="login-actions">
                    <Button
                    Type=@ButtonType.Primary
                    Size=@ButtonSize.Large
                    Icon="microsoft"
                    Loading=@_isLoading
                    OnClick=@HandleLogin
                    Block=@true
                    Style="height: 48px; font-size: 16px;">
                    @UI.Resources.I18n.SignInWithMicrosoft
                </Button>
            </div>

            <Divider>
                <Text Type=@TextElementType.Secondary Style="font-size: 12px;">
                    @UI.Resources.I18n.SecureAuthPoweredByAzure
                </Text>
            </Divider>

            <div class="login-info">
                <div class="info-items">
                    <div class="info-item">
                        <Icon Type="check-circle" />
                        <Text Type=@TextElementType.Secondary>@UI.Resources.I18n.SecureSingleSignOn</Text>
                    </div>
                    <div class="info-item">
                        <Icon Type="shield" />
                        <Text Type=@TextElementType.Secondary>@UI.Resources.I18n.EnterpriseGradeSecurity</Text>
                    </div>
                    <div class="info-item">
                        <Icon Type="team" />
                        <Text Type=@TextElementType.Secondary>@UI.Resources.I18n.TeamCollaborationReady</Text>
                    </div>
                </div>
            </div>
        </Card>
    </div>
</div>
