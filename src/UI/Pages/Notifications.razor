@page "/notifications"
@using Notification = UI.Models.Notification.Notification
@using NotificationType = UI.Models.Notification.NotificationType
@using UI.Interfaces.Services
@using UI.Interfaces.SignalR
@using AntDesign
@using System.Security.Claims
@inject UI.Interfaces.Services.INotificationService NotificationService
@inject UI.Interfaces.SignalR.INotificationSignalRService NotificationSignalRService
@inject IAuthService AuthService
@inject MessageService MessageService
@inject NavigationManager Navigation
@implements IDisposable

<PageHeader Title="@UI.Resources.I18n.Dashboard">
    <PageHeaderExtra>
        <Space>
            <SpaceItem>
                <Button Type=@ButtonType.Primary Icon="check" OnClick=@MarkAllAsReadAsync Disabled=@(!notifications.Any(n => !n.IsRead))>
                    @UI.Resources.I18n.ClearFilters
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Icon="reload" OnClick=@RefreshNotificationsAsync Loading=@isLoading>
                    @UI.Resources.I18n.Refresh
                </Button>
            </SpaceItem>
        </Space>
    </PageHeaderExtra>
</PageHeader>

<Space/>

<div style="padding: 24px; background: #fff; min-height: 280px;">
    @if (isLoading && !notifications.Any())
    {
            <div style="text-align: center; padding: 50px;">
            <Spin Size=@SpinSize.Large />
            <div style="margin-top: 16px;">@UI.Resources.I18n.LoadingMoreBoards</div>
        </div>
    }
    else if (!notifications.Any())
    {
        <Empty Description=@UI.Resources.I18n.NoRecentActivity>
            <Icon Type="bell" Style="font-size: 64px; color: #d9d9d9;" />
        </Empty>
    }
    else
    {
        <AntList DataSource=@notifications
                ItemLayout=@ListItemLayout.Horizontal
                Size=@ListSize.Large>
            <ChildContent Context="notification">
                <ListItem Actions=@GetNotificationActions(notification)>
                    <ListItemMeta>
                        <AvatarTemplate>
                            <Avatar Icon=@GetNotificationIcon(notification.Type)
                                   Style=@($"background-color: {GetNotificationColor(notification.Type)}")/>
                        </AvatarTemplate>
                        <TitleTemplate>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style=@(notification.IsRead ? "" : "font-weight: bold;")>
                                    @GetNotificationTitle(notification.Type)
                                </span>
                                @if (!notification.IsRead)
                                {
                                    <Badge Status=@BadgeStatus.Processing />
                                }
                            </div>
                        </TitleTemplate>
                        <DescriptionTemplate>
                            <div style=@(notification.IsRead ? "color: rgba(0,0,0,0.45)" : "")>
                                @notification.Text
                            </div>
                            <div style="color: rgba(0,0,0,0.45); font-size: 12px; margin-top: 4px;">
                                @notification.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                            </div>
                        </DescriptionTemplate>
                    </ListItemMeta>
                </ListItem>
            </ChildContent>
        </AntList>

        @if (hasMoreNotifications)
        {
            <div style="text-align: center; margin-top: 16px;">
                <Button OnClick=@LoadMoreNotificationsAsync Loading=@isLoadingMore Disabled=@isLoadingMore>
                    @UI.Resources.I18n.LoadMoreBoards
                </Button>
            </div>
        }
    }
</div>

@code {
    private RenderFragment[] GetNotificationActions(Notification notification)
    {
        var actions = new List<RenderFragment>();

        if (!notification.IsRead)
        {
            actions.Add(@<Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick="@(() => MarkAsReadAsync(notification.Id))">@UI.Resources.I18n.MarkAsRead</Button>);
        }
        if (notification.BoardId.HasValue)
        {
            actions.Add(@<Button Size="@ButtonSize.Small" Type="@ButtonType.Link" OnClick="@(() => NavigateToItem(notification))">@UI.Resources.I18n.View</Button>);
        }
        actions.Add(@<Popconfirm Title=@UI.Resources.I18n.ConfirmDeleteTask OnConfirm="@(() => DeleteAsync(notification.Id))" OkText=@UI.Resources.I18n.Yes CancelText=@UI.Resources.I18n.No><Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Danger="true" Icon="delete">@UI.Resources.I18n.DeleteTask</Button></Popconfirm>);

        return actions.ToArray();
    }
}