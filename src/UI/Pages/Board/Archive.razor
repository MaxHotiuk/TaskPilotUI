@page "/board/{boardId}/archive"
@using AntDesign
@using UI.Models.Task

<PageHeader OnBack=@OnBack>
    <TitleTemplate>
        Archived Tasks for "@BoardName"
    </TitleTemplate>
    <PageHeaderContent>
        <Space>
            <Input Size=@InputSize.Large
                       Placeholder="Search archive..." 
                       @bind-Value=@SearchTerm
                       @oninput=@OnSearch
                       AllowClear=@true
                       Style="border-radius: 8px;" />
        </Space>
    </PageHeaderContent>
</PageHeader>

<Space/>

<Card>
    <AntList Class="demo-loadmore-list" DataSource=@ArchivedTasks ItemLayout=ListItemLayout.Horizontal Loading=@InitLoading>
        <ChildContent Context="item">
            <ListItem Actions=@GetActions(item)>
                <ListItemMeta Description=@item.Assignee>
                    <TitleTemplate>
                        <span>@item.Title</span>
                    </TitleTemplate>
                </ListItemMeta>
            </ListItem>
        </ChildContent>
        <LoadMore>
            @if (!InitLoading && !Loading && HasMore)
            {
                <div class="demo-loadmore-btn-content ">
                    <Button OnClick="LoadMore">Load more</Button>
                </div>
            }
        </LoadMore>
    </AntList>
</Card>
