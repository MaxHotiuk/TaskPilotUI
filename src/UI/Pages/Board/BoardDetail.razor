@page "/board/{BoardId}"
@using AntDesign
@using UI.Models.Board
@using UI.Models.Tag
@using UI.Models.Task
@using UI.Models.State
@using UI.Models.Member
@using UI.Models.User
@using UI.Pages.Board.Components
@using UI.Interfaces.Services

<BoardHeader BoardDetail=@_boardDetail
             IsLoading=@IsLoading
             OnBack=@GoBack
             OnShowMembers=@ShowMembersModal
             OnRefresh=@RefreshBoard
             OnCreateTask=@ShowCreateTaskModal
             OnArchive=@ShowArchiveBoardModal
             CurrentUserId=@(_currentUser?.Id.ToString())
             OnManageStates=@ShowManageStatesModal
             OnManageTags=@ShowManageTagsModal
             OnCreateMeeting=@ShowCreateMeetingModal
             OnOnlyMine=@OnOnlyMineToggle
             OnManageMeetings=@ShowManageMeetingsModal />

<BoardColumns BoardDetail=@_boardDetail
              IsLoading=@IsLoading
              OrganizationUsers=@_organizationUsers
              OnTaskClick=@ShowTaskDetails
              OnGoBack=@GoBack />

<MembersModal IsVisible=@_showMembersModal
              BoardDetail=@_boardDetail
              OrganizationUsers=@_organizationUsers
              CanManageMembers=@(CanManageMembers())
              CurrentUserId=@(_currentUser?.Id.ToString())
              OnCancel=@(() => _showMembersModal = false)
              OnAddMember=@ShowAddMemberModal
              OnChangeRole=@HandleChangeRole
              OnRemoveMember=@HandleRemoveMember />

<AddMemberModal IsVisible=@_showAddMemberModal
                IsLoading=@_isAddingMember
                FormModel=@_addMemberForm
                ExistingMembers=@(_boardDetail?.Members ?? new List<BoardMemberDto>())
                BoardOwnerId=@(_boardDetail?.OwnerId)
                OrganizationId=@(_boardDetail?.OrganizationId)
                OrganizationUsers=@_organizationUsers
                OnOk=@AddMember
                OnCancel=@(() => { _showAddMemberModal = false; ResetAddMemberForm(); }) />

<ManageStatesModal IsVisible=@_showManageStatesModal
                   BoardId=@BoardId
                   OnStatesChanged=@(EventCallback.Factory.Create<List<StateDto>>(this, HandleStatesChanged))
                   OnCancel=@(() => _showManageStatesModal = false) />

<ManageTagsModal IsVisible=@_showManageTagsModal
                 BoardId=@BoardId
                 OnTagsChanged=@(EventCallback.Factory.Create<List<TagDto>>(this, HandleTagsChanged))
                 OnCancel=@(() => _showManageTagsModal = false) />

<AddTaskModal IsVisible=@_showAddTaskModal
              IsLoading=@_isAddingTask
              FormModel=@_addTaskForm
              States=@(_boardDetail?.States ?? new List<StateDto>())
              BoardMembers=@(_boardDetail?.Members ?? new List<BoardMemberDto>())
              BoardId=@BoardId
              OrganizationId=@(_boardDetail?.OrganizationId)
              OrganizationUsers=@_organizationUsers
              OnOk=@AddTask
              OnCancel=@(() => { _showAddTaskModal = false; ResetAddTaskForm(); })
              Tags=@(_boardDetail?.Tags?.ToList() ?? new List<TagDto>()) />

<AddMeetingModal IsVisible=@_showAddMeetingModal
                 IsLoading=@_isAddingMeeting
                 FormModel=@_addMeetingForm
                 BoardMembers=@(_boardDetail?.Members ?? new List<BoardMemberDto>())
                 BoardId=@BoardId
                 OrganizationId=@(_boardDetail?.OrganizationId)
                 OrganizationUsers=@_organizationUsers
                 OnOk=@AddMeeting
                 OnCancel=@(() => { _showAddMeetingModal = false; ResetAddMeetingForm(); }) />

<TaskDetailsModal IsVisible=@_showTaskDetailsModal
                  IsLoading=@_isTaskDetailsLoading
                  CurrentTask=@_selectedTask
                  States=@(_boardDetail?.States ?? new List<StateDto>())
                  BoardMembers=@(_boardDetail?.Members ?? new List<BoardMemberDto>())
                  CanManageTask=@(HasBoardAccess())
                  OrganizationId=@(_boardDetail?.OrganizationId)
                  OrganizationUsers=@_organizationUsers
                  OnTaskUpdated=@HandleTaskUpdated
                  OnTaskDeleted=@HandleTaskDeleted
                  OnCancel=@(() => { _showTaskDetailsModal = false; _selectedTask = null; })
                  Tags=@(_boardDetail?.Tags?.ToList() ?? new List<TagDto>()) />

<ManageMeetingsModal IsVisible=@_showManageMeetingsModal
                     IsLoading=@IsLoading
                     BoardMembers=@(_boardDetail?.Members ?? new List<BoardMemberDto>())
                     BoardId=@BoardId
                     OrganizationId=@(_boardDetail?.OrganizationId)
                     OrganizationUsers=@_organizationUsers
                     OnMeetingChanged=@HandleMeetingChanged
                     OnCancel=@(() => _showManageMeetingsModal = false) />

<ArchiveBoardModal IsVisible=@_showArchiveBoardModal
                       IsLoading=@_isArchivingBoard
                       OnOk=@ArchiveBoard
                       OnCancel=@(() => _showArchiveBoardModal = false) />