@page "/board/{boardId}/backlog"
@using AntDesign
@using UI.Models.Backlog


    <PageHeader OnBack=@OnBack>
    <TitleTemplate>
        @string.Format(UI.Resources.I18n.BacklogFor, BoardName)
    </TitleTemplate>
    <PageHeaderContent>
        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            <Input Size=@InputSize.Large
                   Placeholder=@UI.Resources.I18n.SearchYourBoards 
                   @bind-Value=@SearchTerm
                   @oninput=@OnSearch
                   AllowClear=@true
                   Style="border-radius: 8px; min-width: 220px;" />
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>@UI.Resources.I18n.StartDateLabel</span>
                <DatePicker 
                    Size=@InputSize.Large
                    Value=@StartDate
                    ValueChanged="@(async (DateOnly? v) => { StartDate = v; await OnDateChanged(); })"
                    AllowClear="true"
                    Style="border-radius: 8px; width: 140px;" />
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>@UI.Resources.I18n.EndDateLabel</span>
                <DatePicker 
                    Size=@InputSize.Large
                    Value=@EndDate
                    ValueChanged="@(async (DateOnly? v) => { EndDate = v; await OnDateChanged(); })"
                    AllowClear="true"
                    Style="border-radius: 8px; width: 140px;" />
            </div>
        </div>
    </PageHeaderContent>
</PageHeader>

<Space/>

<Card>
    <AntList Class="demo-loadmore-list" DataSource=@BacklogItems ItemLayout=ListItemLayout.Horizontal Loading=@InitLoading>
        <ChildContent Context="item">
            <ListItem>
                <ListItemMeta Description=@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")>
                    <TitleTemplate>
                        <span>@item.Description</span>
                    </TitleTemplate>
                </ListItemMeta>
            </ListItem>
        </ChildContent>
        <LoadMore>
            @if (!InitLoading && !Loading && HasMore)
            {
                <div class="demo-loadmore-btn-content ">
                    <Button OnClick=@LoadMore>@UI.Resources.I18n.LoadMoreBoards</Button>
                </div>
            }
        </LoadMore>
    </AntList>
</Card>
