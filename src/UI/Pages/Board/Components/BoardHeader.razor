@using AntDesign
@using UI.Models.Board

<PageHeader Title=@(BoardDetail?.Name ?? UI.Resources.I18n.Loading)
            OnBack="OnBack">
    <PageHeaderExtra>
        <Space>
            @if (BoardDetail != null && CurrentUserId != null && BoardDetail.OwnerId == CurrentUserId)
            {
                <SpaceItem>
                    <Button Type=@ButtonType.Default
                            Danger="true"
                            Icon="delete"
                            OnClick=@OnArchive>
                        @UI.Resources.I18n.ArchiveBoard
                    </Button>
                </SpaceItem>
            }
            <SpaceItem>
                    <Button Type=@ButtonType.Default
                            Icon="ordered-list" 
                            OnClick="OnBacklog">
                    @UI.Resources.I18n.Backlog
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="team" 
                        OnClick="OnShowMembers">
                    @UI.Resources.I18n.MembersLabel
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="reload" 
                        Loading="IsLoading"
                        OnClick="OnRefresh">
                    @UI.Resources.I18n.Loading
                </Button>
            </SpaceItem>
            <SpaceItem>
                    <Button Type=@ButtonType.Default
                        Icon="setting" 
                        OnClick="OnManageStates">
                    @UI.Resources.I18n.States
                </Button>
            </SpaceItem>
            <SpaceItem>
                    <Button Type=@ButtonType.Default
                        Icon="tag"
                        OnClick="OnManageTags">
                    @UI.Resources.I18n.Tags
                </Button>
            </SpaceItem>
            <SpaceItem>
                    <Button Type=@ButtonType.Default
                        Icon="phone"
                        OnClick="OnManageMeetings">
                    @UI.Resources.I18n.Meetings
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Primary
                        Icon="plus" 
                        OnClick="OnCreateTask">
                    @UI.Resources.I18n.AddNewTask
                </Button>
            </SpaceItem>
            <SpaceItem>
                    <Button Type=@ButtonType.Default
                        Icon="user"
                        OnClick="OnOnlyMineToggle">
                    @if (IsOnlyMine)
                    {
                        <span>@UI.Resources.I18n.MyTasks</span>
                    }
                    else
                    {
                        <span>@UI.Resources.I18n.AllTasks</span>
                    }
                </Button>
            </SpaceItem>
        </Space>
    </PageHeaderExtra>
    
    <PageHeaderContent>
        @if (BoardDetail != null)
        {
            <Descriptions Size=@DescriptionsSize.Small Column="2">
                <DescriptionsItem Title=@UI.Resources.I18n.Description Span="2">
                    @(BoardDetail.Description ?? UI.Resources.I18n.NoDescription)
                </DescriptionsItem>
                <DescriptionsItem Title=@UI.Resources.I18n.TasksLabel>
                    @BoardDetail.Tasks.Count
                </DescriptionsItem>
                <DescriptionsItem Title=@UI.Resources.I18n.MembersLabel>
                    @BoardDetail.Members.Count
                </DescriptionsItem>
            </Descriptions>
        }
    </PageHeaderContent>
</PageHeader>
