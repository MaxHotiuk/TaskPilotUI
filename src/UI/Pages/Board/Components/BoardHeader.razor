@using AntDesign
@using UI.Models.Board

<PageHeader Title=@(BoardDetail?.Name ?? "Loading...")
            OnBack="OnBack">
    <PageHeaderExtra>
        <Space>
            @if (BoardDetail != null && CurrentUserId != null && BoardDetail.OwnerId == CurrentUserId)
            {
                <SpaceItem>
                    <Button Type=@ButtonType.Default
                            Danger="true"
                            Icon="delete"
                            OnClick=@OnArchive>
                        Archive Board
                    </Button>
                </SpaceItem>
            }
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="ordered-list" 
                        OnClick="OnBacklog">
                    Backlog
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="team" 
                        OnClick="OnShowMembers">
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="reload" 
                        Loading="IsLoading"
                        OnClick="OnRefresh">
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="setting" 
                        OnClick="OnManageStates">
                    States
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="tag"
                        OnClick="OnManageTags">
                    Tags
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Primary
                        Icon="phone"
                        OnClick="OnCreateMeeting">
                    Schedule Meeting
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Primary
                        Icon="plus" 
                        OnClick="OnCreateTask">
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="user"
                        OnClick="OnOnlyMineToggle">
                    @if (IsOnlyMine)
                    {
                        <span>My Tasks</span>
                    }
                    else
                    {
                        <span>All Tasks</span>
                    }
                </Button>
            </SpaceItem>
        </Space>
    </PageHeaderExtra>
    
    <PageHeaderContent>
        @if (BoardDetail != null)
        {
            <Descriptions Size=@DescriptionsSize.Small Column="2">
                <DescriptionsItem Title="Description" Span="2">
                    @(BoardDetail.Description ?? "No description")
                </DescriptionsItem>
                <DescriptionsItem Title="Tasks">
                    @BoardDetail.Tasks.Count
                </DescriptionsItem>
                <DescriptionsItem Title="Members">
                    @BoardDetail.Members.Count
                </DescriptionsItem>
            </Descriptions>
        }
    </PageHeaderContent>
</PageHeader>
