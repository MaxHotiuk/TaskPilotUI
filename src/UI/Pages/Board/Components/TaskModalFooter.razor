@using AntDesign
@using Microsoft.AspNetCore.Components.Web

<div class="task-modal-footer">
    @if (IsEditing)
    {
        <Button OnClick=@OnCancelEdit>@UI.Resources.I18n.Cancel</Button>
        <Button Type=@ButtonType.Primary
                Loading=@IsLoading
                OnClick=@OnSaveChanges>
            @UI.Resources.I18n.SaveChanges
        </Button>
    }
    else
    {
        <Button OnClick=@OnClose>@UI.Resources.I18n.Close</Button>
        
        @if (CanManageTask)
        {
            <Button Type=@ButtonType.Default OnClick=@OnEdit>@UI.Resources.I18n.EditTask</Button>
            
                <Popconfirm Title="@UI.Resources.I18n.ConfirmDeleteTask"
                        OnConfirm=@OnDelete
                        OkText="@UI.Resources.I18n.Yes"
                        CancelText="@UI.Resources.I18n.No">
                <Button Type=@ButtonType.Primary
                        Danger=@true
                        Loading=@IsLoading>
                    @UI.Resources.I18n.DeleteTask
                </Button>
            </Popconfirm>

                <Popconfirm Title="@UI.Resources.I18n.ConfirmArchiveTask"
                        OnConfirm=@OnArchive
                        OkText="@UI.Resources.I18n.Yes"
                        CancelText="@UI.Resources.I18n.No">
                <Button Type=@ButtonType.Primary
                        Danger=@true
                        Loading=@IsLoading>
                    @UI.Resources.I18n.ArchiveTask
                </Button>
            </Popconfirm>
        }
    }
</div>
