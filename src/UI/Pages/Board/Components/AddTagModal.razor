@using AntDesign
@using UI.Models.Tag

<Modal Title="@UI.Resources.I18n.AddTag"
       Visible=@IsVisible
       OnOk=@HandleOk
       OnCancel=@HandleCancel
       ConfirmLoading=@IsLoading
       Width="400">
    <Form Model=@FormModel
          LabelCol="new ColLayoutParam { Span = 6 }"
          WrapperCol="new ColLayoutParam { Span = 18 }"
          OnFinish=@HandleSubmit
          OnFinishFailed=@HandleSubmitFailed>

        <FormItem Label=@UI.Resources.I18n.TagNameLabel Required>
            <Input @bind-Value=@FormModel.Name
                   Placeholder=@UI.Resources.I18n.EnterTagNamePlaceholder
                   MaxLength="50" />
        </FormItem>
        <FormItem Label=@UI.Resources.I18n.TagColorLabel>
            @* <Input @bind-Value=@FormModel.Color
                   Placeholder="Enter tag color (e.g. green or blue)"
                   MaxLength="20" /> *@
            <input type="color" @bind-value=@FormModel.Color />
        </FormItem>
    </Form>
</Modal>
