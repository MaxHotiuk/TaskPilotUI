@using AntDesign
@using UI.Models.Task
@using UI.Models.State
@using UI.Models.Member
@using UI.Models.User

@using UI.Models.Tag

@code {
    [Parameter]
    public List<TagDto>? Tags { get; set; }
}

<Card Class="task-card" Bordered>
    <Body>
        <div class="task-header">
            <div class="task-title-row">
                <Icon Type="file-text" />
                <Title Level="4" Class="task-title">@Task.Title</Title>
                <Tag Color=@TagColor.Blue Icon="flag">@GetStateName(Task.StateId)</Tag>
            </div>
            
            @if (!string.IsNullOrEmpty(Task.Description))
            {
                <div class="task-description">
                    <Icon Type="align-left" />
                    <span>@Task.Description</span>
                </div>
            }
        </div>

        <div class="task-details">
            <div class="detail-item">
                <Icon Type="tag" />
                <span class="label">Tag:</span>
                @if (Task.TagId != null && Tags != null)
                {
                    var tag = Tags.FirstOrDefault(t => t.Id == Task.TagId);
                    if (tag != null)
                    {
                        <Tag Color=@tag.Color>@tag.Name</Tag>
                    }
                    else
                    {
                        <span class="no-tag">No tag</span>
                    }
                }
                else
                {
                    <span class="no-tag">No tag</span>
                }
            </div>
            <div class="detail-item">
                <Icon Type="user" />
                <span class="label">Assignee:</span>
                @if (!string.IsNullOrEmpty(Task.AssigneeId))
                {
                    <div class="assignee-info">
                        @if (IsAvatarLoading(Task.AssigneeId))
                        {
                            <Avatar Size=AvatarSize.Small>@GetAssigneeInitials(Task.AssigneeId)</Avatar>
                        }
                        else
                        {
                            var avatarUrl = GetAvatarUrl(Task.AssigneeId);
                            if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <Avatar Size=AvatarSize.Small Src=@avatarUrl />
                            }
                            else
                            {
                                <Avatar Size=AvatarSize.Small>@GetAssigneeInitials(Task.AssigneeId)</Avatar>
                            }
                        }
                        <span>@GetAssigneeName(Task.AssigneeId)</span>
                    </div>
                }
                else
                {
                    <span class="not-assigned">Not assigned</span>
                }
            </div>

            <div class="detail-item">
                <Icon Type="flag" />
                <span class="label">Priority:</span>
                <Tag Color=@GetPriorityColor(Task.Priority) Icon="exclamation-circle">@GetPriorityLabel(Task.Priority)</Tag>
            </div>

            <div class="detail-item">
                <Icon Type="calendar" />
                <span class="label">Due:</span>
                @if (!string.IsNullOrEmpty(Task.DueDate))
                {
                    <div class="due-date-info">
                        <Tag Color=@GetDueDateColor(Task.DueDate) Icon="clock-circle">@FormatDueDate(Task.DueDate)</Tag>
                        @if (IsDueSoon(Task.DueDate))
                        {
                            <Alert Type=@AlertType.Warning Message=@GetDueIndicator(Task.DueDate) ShowIcon=@true Banner=@true Class="due-alert" />
                        }
                    </div>
                }
                else
                {
                    <span class="no-due-date">No due date</span>
                }
            </div>
        </div>

        <div class="task-timestamps">
            <span class="timestamp">
                <Icon Type="plus-circle" />
                Created @GetCreatedTimeString()
            </span>
            @if (!string.IsNullOrEmpty(Task.UpdatedAt))
            {
                <span class="timestamp">
                    <Icon Type="edit" />
                    Updated @GetUpdatedTimeString()
                </span>
            }
        </div>
    </Body>
</Card>