@using AntDesign
@using UI.Models.State

<Modal Title="@UI.Resources.I18n.AddNewState"
       Visible=@IsVisible
       OnOk=@HandleOk
       OnCancel=@HandleCancel
       ConfirmLoading=@IsLoading
       Width="400">
    <Form Model=@FormModel
          LabelCol="new ColLayoutParam { Span = 6 }"
          WrapperCol="new ColLayoutParam { Span = 18 }"
          OnFinish=@HandleSubmit
          OnFinishFailed=@HandleSubmitFailed>

        <FormItem Label=@UI.Resources.I18n.StateNameLabel Required>
            <Input @bind-Value=@FormModel.Name
                   Placeholder=@UI.Resources.I18n.EnterStateNamePlaceholder
                   MaxLength="50" />
        </FormItem>

        <div style="margin-bottom: 16px;">
            <Text Type=@TextElementType.Secondary Style="font-size: 12px;">
                @UI.Resources.I18n.DefaultStatesDescription
            </Text>
        </div>

    </Form>
</Modal>
