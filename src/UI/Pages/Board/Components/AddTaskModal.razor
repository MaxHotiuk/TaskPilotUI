@using AntDesign
@using UI.Models.Task
@using UI.Models.State
@using UI.Models.Member
@using UI.Models.User

<Modal Title="@UI.Resources.I18n.AddNewTask"
       Visible=@IsVisible
       OnOk=@HandleOk
       OnCancel=@HandleCancel
       ConfirmLoading=@IsLoading
       Width="600">
    <Form Model=@FormModel
          LabelCol="new ColLayoutParam { Span = 6 }"
          WrapperCol="new ColLayoutParam { Span = 18 }"
          OnFinish=@HandleSubmit
          OnFinishFailed=@HandleSubmitFailed>

        <FormItem Label=@UI.Resources.I18n.TaskTitleLabel Required>
            <Input @bind-Value=@FormModel.Title
                   Placeholder=@UI.Resources.I18n.EnterTaskTitle 
                   MaxLength="200" />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.DescriptionLabel>
            <TextArea @bind-Value=@FormModel.Description
                      Placeholder=@UI.Resources.I18n.EnterTaskDescription
                      Rows="3"
                      MaxLength="1000" />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.States Required>
            <Select @bind-Value=@FormModel.StateId 
                    TItemValue="int" 
                    TItem="int" 
                    Style="width: 100%;" 
                    Placeholder=@UI.Resources.I18n.SelectStatePlaceholder>
                <SelectOptions>
                    @foreach (var state in States)
                    {
                        <SelectOption TItemValue="int" TItem="int" Value=@state.Id Label=@state.Name />
                    }
                </SelectOptions>
            </Select>
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.AssigneeLabel>
            <div style="position: relative;">
                <Select @bind-Value=@FormModel.AssigneeId 
                        TItemValue="string" 
                        TItem="string" 
                        Style="width: 100%;" 
                        Placeholder=@UI.Resources.I18n.SelectAssigneePlaceholder>
                    <SelectOptions>
                        @foreach (var member in BoardMembers)
                        {
                            var user = AllUsers.FirstOrDefault(u => u.Id.ToString() == member.UserId);
                            if (user != null)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value=@user.Id.ToString() Label=@($"{user.Username} ({user.Email})") />
                            }
                        }
                    </SelectOptions>
                </Select>
            </div>
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.DueLabel>
            <Input @bind-Value=@DueDateString
                   Type="@InputType.Date"
                   Style="width: 100%;"
                   Placeholder=@UI.Resources.I18n.SelectDueDatePlaceholder />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.PriorityLabel Required>
            <Select @bind-Value=@FormModel.Priority TItemValue="int" TItem="int" Style="width: 100%;" Placeholder=@UI.Resources.I18n.SelectStatePlaceholder>
                <SelectOptions>
                    <SelectOption TItemValue="int" TItem="int" Value="1" Label=@UI.Resources.I18n.PriorityLow />
                    <SelectOption TItemValue="int" TItem="int" Value="2" Label=@UI.Resources.I18n.PriorityNormal />
                    <SelectOption TItemValue="int" TItem="int" Value="3" Label=@UI.Resources.I18n.PriorityHigh />
                    <SelectOption TItemValue="int" TItem="int" Value="4" Label=@UI.Resources.I18n.PriorityImmediate />
                </SelectOptions>
            </Select>
        </FormItem>

        <FormItem Label="Tag">
            <Select @bind-Value=@FormModel.TagId TItemValue="int?" TItem="int?" Style="width: 100%;" Placeholder="Select tag (optional)">
                <SelectOptions>
                    <SelectOption TItemValue="int?" TItem="int?" Value=null Label=@UI.Resources.I18n.NoTagOption />
                    @foreach (var tag in Tags)
                    {
                        <SelectOption TItemValue="int?" TItem="int?" Value=@tag.Id Label=@tag.Name />
                    }
                </SelectOptions>
            </Select>
        </FormItem>

    </Form>
</Modal>
