@using AntDesign
@using UI.Models.Board
@using UI.Models.Task
@using UI.Models.State
@using UI.Models.Member

<div class="board-content">
    @if (IsLoading && BoardDetail == null)
    {
        <div class="loading-container">
            <Spin Size=@SpinSize.Large Tip="Loading board...">
                <div style="height: 400px;"></div>
            </Spin>
        </div>
    }
    else if (BoardDetail != null)
    {
        <div class="board-columns">
            @foreach (var state in BoardDetail.States.OrderBy(s => s.Order))
            {
                <div class="state-column">
                    <div class="state-header">
                        <div>
                            <Text Strong>@state.Name</Text>
                        </div>
                        <div>
                            <Badge Class="site-badge-count-109"
                                Count=@GetTaskCountForState(state.Id)
                                Style="background-color: rgb(58, 143, 234); " />
                        </div>
                    </div>
                    <div class="task-container" style="max-height: 600px; overflow-y: auto;">
                        @if (GetTasksForState(state.Id).Any())
                        {
                            <div class="task-list">
                                @foreach (var task in GetTasksForState(state.Id))
                                {
                                    <div class="task-item-wrapper" @onclick=@(() => OnTaskClick.InvokeAsync(task))>
                                        <Card Size=@CardSize.Small 
                                              Class="task-item"
                                              Hoverable>
                                            <Body>
                                                <div class="task-card">
                                                    <div style="display: flex; align-items: center; justify-content: space-between;">
                                                        <div style="flex: 1; min-width: 0;">
                                                            <Text Strong>@task.Title</Text>
                                                        </div>
                                                        <div style="flex-shrink: 0;">
                                                            <Tag Style="margin-right: 0px !important;" Color=@GetPriorityColor(task.Priority) Icon="exclamation-circle">
                                                                @GetPriorityLabel(task.Priority)
                                                            </Tag>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(task.Description))
                                                    {
                                                        <div class="task-title">
                                                            <Text Type=@TextElementType.Secondary>
                                                                @TruncateDescription(task.Description)
                                                            </Text>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(task.AssigneeId))
                                                    {
                                                        <div class="task-assignee">
                                                            <Tag Color=@TagColor.Blue>@GetAssigneeName(task.AssigneeId)</Tag>
                                                        </div>
                                                    }
                                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                                                        @if (!string.IsNullOrEmpty(task.DueDate))
                                                        {
                                                            <div class="task-due-date">
                                                                <Tag Color=@GetDueDateColor(task.DueDate)>
                                                                    <Icon Type="clock-circle" />
                                                                    Due: @FormatDueDate(task.DueDate)
                                                                </Tag>
                                                            </div>
                                                        }
                                                        @if (task.TagId != null && BoardDetail.Tags != null)
                                                        {
                                                            var tag = BoardDetail.Tags.FirstOrDefault(t => t.Id == task.TagId);
                                                            if (tag != null)
                                                            {
                                                                <Tag Style="margin-left: auto; margin-right: 0px !important;" Color=@tag.Color>@tag.Name</Tag>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </Body>
                                        </Card>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                No tasks in this state
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="error-container">
            <h3>Board Not Found</h3>
            <p>The board you're looking for doesn't exist or you don't have access to it.</p>
            <Button Type=@ButtonType.Primary OnClick=@(() => OnGoBack.InvokeAsync())>
                Go Back
            </Button>
        </div>
    }
</div>
