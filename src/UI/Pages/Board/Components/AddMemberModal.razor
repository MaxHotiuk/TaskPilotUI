@using AntDesign
@using UI.Models.Member
@using UI.Models.User

<Modal Title="Invite Board Members"
       Visible=@IsVisible
       OnOk=@OnOk
       OnCancel=@OnCancel
       ConfirmLoading=@IsLoading
       OkText="@("Send Invitations")"
       Width="600">
    <Form Model=@FormModel Layout=@FormLayout.Vertical>
        <FormItem Label=@UI.Resources.I18n.SearchUsersPlaceholder>
            <div style="position: relative;">
                <Input @bind-Value=@SearchText
                       @oninput=@OnSearchInput
                       Placeholder=@UI.Resources.I18n.SearchUsersPlaceholder
                       Style="width: 100%;" />
                
                @if (SearchResults.Any() && !string.IsNullOrWhiteSpace(SearchText))
                {
                    <div class="user-search-dropdown">
                        @foreach (var user in SearchResults)
                        {
                            <div @onclick=@(() => SelectUser(user)) class="user-search-item">
                                <div style="font-weight: 500;">@user.Username</div>
                                <div style="font-size: 12px; color: #999;">@user.Email</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </FormItem>
        
        @if (FormModel.SelectedUsers.Any())
        {
            <FormItem Label=@UI.Resources.I18n.SelectedUsers>
                <div class="selected-users-container">
                    @foreach (var user in FormModel.SelectedUsers)
                    {
                        <Tag Closable="true" OnClose=@(() => RemoveUser(user))>
                            <div class="user-tag">
                                <span class="username">@user.Username</span>
                                <span class="email">(@user.Email)</span>
                            </div>
                        </Tag>
                    }
                </div>
            </FormItem>
        }
        
        <FormItem Label=@UI.Resources.I18n.RoleLabelText>
            <Select @bind-Value=@FormModel.Role TItemValue="string" TItem="string" Style="width: 100%;" Placeholder=@UI.Resources.I18n.SelectRolePlaceholder>
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value=@("Member") Label=@UI.Resources.I18n.MemberLabelText />
                    <SelectOption TItemValue="string" TItem="string" Value=@("Owner") Label=@UI.Resources.I18n.OwnerLabelText />
                </SelectOptions>
            </Select>
        </FormItem>
    </Form>
</Modal>
