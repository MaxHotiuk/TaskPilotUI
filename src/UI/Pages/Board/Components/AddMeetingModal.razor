@using AntDesign
@using UI.Models.Meeting
@using UI.Models.Member
@using UI.Models.User

<Modal Title="@UI.Resources.I18n.ScheduleNewMeeting"
       Visible=@IsVisible
       OnOk=@(async () => await HandleOk())
       OnCancel=@(async () => await HandleCancel())
       ConfirmLoading=@IsLoading
       Width="600">
    <Form Model=@FormModel
          LabelCol="new ColLayoutParam { Span = 6 }"
          WrapperCol="new ColLayoutParam { Span = 18 }"
      OnFinish=@HandleSubmit
      OnFinishFailed=@HandleSubmitFailed>

        <FormItem Label=@UI.Resources.I18n.EnterMeetingTitle Required>
            <Input @bind-Value=@FormModel.Title
                   Placeholder=@UI.Resources.I18n.EnterMeetingTitle 
                   MaxLength="200" />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.DescriptionLabel>
            <TextArea @bind-Value=@FormModel.Description
                      Placeholder=@UI.Resources.I18n.EnterMeetingDescription
                      Rows="3"
                      MaxLength="1000" />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.SelectMeetingDateTime>
            <DatePicker @bind-Value=@ScheduledAtValue
                       ShowTime="true"
                       Format="yyyy-MM-dd HH:mm"
                       Style="width: 100%;"
                       Placeholder=@UI.Resources.I18n.SelectMeetingDateTime />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.DurationMinutesLabel>
            <AntDesign.InputNumber @bind-Value=@FormModel.Duration
                        Min="15"
                        Max="480"
                        Step="15"
                        Style="width: 100%;"
                        Placeholder=@UI.Resources.I18n.MeetingDurationPlaceholder />
        </FormItem>

        <FormItem Label=@UI.Resources.I18n.AttendeesLabel>
            <Select @bind-Values=@SelectedMemberIds
                    Mode=@SelectMode.Multiple
                    TItemValue="string"
                    TItem="string"
                    Style="width: 100%;"
                    Placeholder=@UI.Resources.I18n.SelectMeetingAttendees
                    MaxTagCount="3">
                <SelectOptions>
                    @foreach (var member in BoardMembers)
                    {
                        var user = AllUsers.FirstOrDefault(u => u.Id.ToString() == member.UserId);
                        if (user != null)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value=@user.Id.ToString() Label=@($"{user.Username} ({user.Email})") />
                        }
                    }
                </SelectOptions>
            </Select>
        </FormItem>

                    <FormItem Label=@UI.Resources.I18n.ExternalMeetingLinkLabel>
                        <Switch Checked="@UseExternalLink" CheckedChanged="@HandleExternalLinkToggle" />
                        <span style="margin-left: 8px;">@UI.Resources.I18n.UseExternalMeetingLink</span>
                    </FormItem>

                    @if (UseExternalLink)
                    {
                        <FormItem Label=@UI.Resources.I18n.ExternalMeetingLinkLabel>
                            <Input @bind-Value=@FormModel.ExternalUrl
                                   Placeholder="https://..."
                                   MaxLength="500" />
                        </FormItem>
                    }

                </Form>
            </Modal>