@using AntDesign
@using UI.Models.Comment
@using UI.Models.User
@using UI.Interfaces.Services
@using UI.Pages.Board.Components

<div class="task-comments-container">
    <div class="comments-header">
        <h4>Comments (@(TotalComments))</h4>
        <div class="comments-search">
            <Search Placeholder="Search comments..." 
                   @bind-Value=@SearchTerm
                   OnSearch=@OnSearchComments
                   OnPressEnter=@OnSearchComments
                   AllowClear=@true
                   Size=InputSize.Small
                   Style="width: 250px;" />
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="comments-loading">
            <Spin Size=SpinSize.Small Tip="Loading comments...">
                <div style="height: 100px;"></div>
            </Spin>
        </div>
    }
    else
    {
        <div class="comments-list">
            @if (Comments?.Any() == true)
            {
                @foreach (var comment in Comments)
                {
                    <div class="comment-item" key="@comment.Id">
                        <div class="comment-header">
                            <div class="comment-author">
                                @if (IsAvatarLoading(comment.AuthorId))
                                {
                                    <Avatar Size=AvatarSize.Small>
                                        @GetAuthorInitials(comment.AuthorId)
                                    </Avatar>
                                }
                                else
                                {
                                    var avatarUrl = GetAvatarUrl(comment.AuthorId);
                                    if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <Avatar Size=AvatarSize.Small Src=@avatarUrl />
                                    }
                                    else
                                    {
                                        <Avatar Size=AvatarSize.Small>
                                            @GetAuthorInitials(comment.AuthorId)
                                        </Avatar>
                                    }
                                }
                                <span class="author-name">@GetAuthorName(comment.AuthorId)</span>
                            </div>
                            <div class="comment-meta">
                                <span class="comment-date">@FormatDate(comment.CreatedAt)</span>
                                @if (CanEditComment(comment))
                                {
                                    <Dropdown Trigger=@(new AntDesign.Trigger[] { AntDesign.Trigger.Click })>
                                        <Overlay>
                                            <Menu>
                                                <MenuItem OnClick=@(() => StartEditComment(comment))>
                                                    <Icon Type="edit" /> Edit
                                                </MenuItem>
                                                <MenuItem OnClick=@(() => DeleteComment(comment.Id)) Danger="true">
                                                    <Icon Type="delete" /> Delete
                                                </MenuItem>
                                            </Menu>
                                        </Overlay>
                                        <ChildContent>
                                            <Button Type=@ButtonType.Text Size=@ButtonSize.Small Icon="more">
                                            </Button>
                                        </ChildContent>
                                    </Dropdown>
                                }
                            </div>
                        </div>
                        
                        @if (EditingCommentId == comment.Id)
                        {
                            <div class="comment-edit-form">
                                <TextArea @bind-Value=EditingContent
                                         Rows="3" 
                                         Placeholder="Edit your comment..."
                                         MaxLength="1000"
                                         ShowCount=@true />
                                <div class="comment-edit-actions">
                                    <Button Size=@ButtonSize.Small 
                                           OnClick=@CancelEditComment
                                           Type=@ButtonType.Default>
                                        Cancel
                                    </Button>
                                    <Button Size=@ButtonSize.Small
                                           OnClick=@(() => SaveEditComment(comment.Id))
                                           Type=@ButtonType.Primary
                                           Loading=@IsUpdating
                                           Disabled=@(string.IsNullOrWhiteSpace(EditingContent))>
                                        Save
                                    </Button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="comment-content">
                                @((MarkupString)FormatCommentContent(comment.Content))
                            </div>
                            <CommentAttachments CommentId="@comment.Id" />
                        }
                    </div>
                }

                @if (HasMoreComments)
                {
                    <div class="load-more-section">
                        <Button Type=@ButtonType.Default
                               Size=@ButtonSize.Small
                               Loading=@IsLoadingMore
                               OnClick=@LoadMoreComments
                               Block="true"
                               Style="margin-top: 16px;">
                            @if (IsLoadingMore)
                            {
                                <span>Loading more comments...</span>
                            }
                            else
                            {
                                <span>Load more comments</span>
                            }
                        </Button>
                    </div>
                }
            }
            else
            {
                <div class="no-comments">
                    <Empty>
                        <DescriptionTemplate>
                            @if (IsSearching)
                            {
                                <span>No comments found matching "@SearchTerm"</span>
                            }
                            else
                            {
                                <span>No comments yet. Be the first to comment on this task</span>
                            }
                        </DescriptionTemplate>
                    </Empty>
                </div>
            }
        </div>

        @if (CanAddComment)
        {
            <div class="add-comment-section">
                <div class="add-comment-form enhanced-add-comment-form">
                    <div class="comment-input-header">
                        @if (IsAvatarLoading(CurrentUserId!))
                        {
                            <Avatar Size=AvatarSize.Small>
                                @GetAuthorInitials(CurrentUserId!)
                            </Avatar>
                        }
                        else
                        {
                            var avatarUrl = GetAvatarUrl(CurrentUserId!);
                            if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <Avatar Size=AvatarSize.Small Src=@avatarUrl />
                            }
                            else
                            {
                                <Avatar Size=AvatarSize.Small>
                                    @GetAuthorInitials(CurrentUserId!)
                                </Avatar>
                            }
                        }
                        <span class="current-user-name">@GetCurrentUserName()</span>
                    </div>

                    <div class="comment-textarea-wrapper">
                        <TextArea @bind-Value=NewCommentContent
                                 Rows="3"
                                 Placeholder="Add a comment..."
                                 MaxLength="1000"
                                 ShowCount=@true
                                 @onkeydown=@HandleKeyDown
                                 class="comment-textarea" />
                    </div>

                    <div class="attachment-row">
                        <label class="attachment-upload-label">
                            <InputFile OnChange=@OnAttachmentsSelected multiple style="display: none;" />
                            <span class="avatar-upload-btn attachment-btn">
                                <Icon Type="paper-clip" /> Attach files
                            </span>
                        </label>
                        @if (SelectedAttachmentNames != null && SelectedAttachmentNames.Any())
                        {
                            @for (int i = 0; i < SelectedAttachmentNames.Count; i++)
                            {
                                var name = SelectedAttachmentNames[i];
                                var displayName = name?.Length > 8 ? name.Substring(0, 8) + "..." : name;
                                var currentIndex = i;
                                <span class="attachment-badge">
                                    📎 @displayName
                                    <Button Size=@ButtonSize.Small Type=@ButtonType.Text OnClick=@(() => RemoveAttachmentAt(currentIndex))>
                                        <Icon Type="close" />
                                    </Button>
                                </span>
                            }
                            <Button Size=@ButtonSize.Small OnClick=@ClearAttachments Type=@ButtonType.Text class="remove-attachment-btn">Remove All</Button>
                        }
                    </div>

                    <div class="comment-actions">
                        <div class="comment-actions-left">
                            <Text Type=@TextElementType.Secondary Style="font-size: 12px;">
                                Press Ctrl+Enter to post
                            </Text>
                        </div>
                        <div class="comment-actions-right">
                            <Button Size=@ButtonSize.Small
                                   OnClick=@ClearNewComment
                                   Type=@ButtonType.Default
                                   Disabled=@(string.IsNullOrWhiteSpace(NewCommentContent))>
                                Clear
                            </Button>
                            <Button Size=@ButtonSize.Small
                                   OnClick=@AddComment
                                   Type=@ButtonType.Primary
                                   Loading=@IsAdding
                                   Disabled=@(string.IsNullOrWhiteSpace(NewCommentContent))>
                                Comment
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>