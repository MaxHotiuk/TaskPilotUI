@using AntDesign
@using UI.Models.Meeting
@using UI.Models.Member
@using UI.Models.User

<Modal Title="Manage Meetings"
       Visible=@IsVisible
       OnCancel=@HandleCancel
       Footer=@null
       Width="900"
       Centered>
    
    <div class="meeting-management-container">
        <div class="meeting-header">
            <Title Level="4">Board Meetings</Title>
            <Button Type=@ButtonType.Primary
                    Icon="plus" 
                    OnClick=@ShowAddMeetingForm
                    Loading=@IsLoading>
                Schedule New Meeting
            </Button>
        </div>

        <div class="meetings-list">
            @if (IsLoading && !Meetings.Any())
            {
                <div class="loading-container">
                    <Spin Size=@SpinSize.Large />
                </div>
            }
            else if (!Meetings.Any())
            {
                <Empty Description=@("No meetings scheduled for this board")>
                    <Button Type=@ButtonType.Primary OnClick=@ShowAddMeetingForm>
                        Schedule First Meeting
                    </Button>
                </Empty>
            }
            else
            {
                @foreach (var meeting in Meetings.OrderBy(m => m.ScheduledAt))
                {
                    <Card Class="meeting-card" Size=CardSize.Small>
                        <div class="meeting-item">
                            <div class="meeting-info">
                                <div class="meeting-title">
                                    <Text Strong>@meeting.Title</Text>
                                    <Tag Color=@GetMeetingStatusColor(meeting)>
                                        @GetMeetingStatus(meeting)
                                    </Tag>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(meeting.Description))
                                {
                                    <div class="meeting-description">
                                        <Text Type=@TextElementType.Secondary>@meeting.Description</Text>
                                    </div>
                                }
                                
                                <div class="meeting-details">
                                    <div class="meeting-detail-item">
                                        <Icon Type="calendar" Theme=@IconThemeType.Outline />
                                        <span>
                                            @if (meeting.ScheduledAt.HasValue)
                                            {
                                                var start = meeting.ScheduledAt.Value;
                                                var end = meeting.Duration.HasValue ? start.AddMinutes(meeting.Duration.Value) : start;
                                                @($"{start:MMM dd, yyyy HH:mm} - {end:HH:mm}")
                                            }
                                        </span>
                                    </div>
                                    
                                    @if (meeting.Duration.HasValue)
                                    {
                                        <div class="meeting-detail-item">
                                            <Icon Type="clock-circle" Theme=@IconThemeType.Outline />
                                            <span>@meeting.Duration minutes</span>
                                        </div>
                                    }
                                    
                                    <div class="meeting-detail-item">
                                        <Icon Type="link" Theme=@IconThemeType.Outline />
                                        <a href=@meeting.Link target="_blank">@meeting.Link</a>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="meeting-actions">
                                <Button Type=@ButtonType.Text
                                        Icon="edit" 
                                        Size=@ButtonSize.Small
                                        OnClick=@(() => ShowEditMeetingForm(meeting))>
                                    Edit
                                </Button>
                                <Popconfirm Title="Are you sure you want to delete this meeting?"
                                           OnConfirm=@(() => DeleteMeeting(meeting.Id.ToString()))
                                           OkText="Yes"
                                           CancelText="No">
                                    <Button Type=@ButtonType.Text
                                            Danger
                                            Icon="delete" 
                                            Size=@ButtonSize.Small
                                            Loading=@(DeletingMeetingId == meeting.Id)>
                                        Delete
                                    </Button>
                                </Popconfirm>
                            </div>
                        </div>
                    </Card>
                }
            }
        </div>
    </div>
</Modal>

<Modal Title=@(IsEditMode ? "Edit Meeting" : "Schedule New Meeting")
       Visible=@_showMeetingForm
       OnOk=@HandleMeetingFormOk
       OnCancel=@HandleMeetingFormCancel
       ConfirmLoading=@_isSubmittingForm
       Width="600">
    
    <Form Model=@_meetingForm
          LabelCol="new ColLayoutParam { Span = 6 }"
          WrapperCol="new ColLayoutParam { Span = 18 }"
          OnFinish=@HandleMeetingFormSubmit>

        <FormItem Label="Meeting Title" Required>
            <Input @bind-Value=@_meetingForm.Title
                   Placeholder="Enter meeting title" 
                   MaxLength="200" />
        </FormItem>

        <FormItem Label="Description">
            <TextArea @bind-Value=@_meetingForm.Description
                      Placeholder="Enter meeting description (optional)"
                      Rows="3"
                      MaxLength="1000" />
        </FormItem>

        <FormItem Label="Domain" Required>
            <Input @bind-Value=@_meetingForm.Domain
                   Placeholder="Enter meeting domain/platform" 
                   MaxLength="100" />
        </FormItem>

        <FormItem Label="Scheduled Date & Time">
            <DatePicker @bind-Value=@_scheduledAtValue
                       ShowTime="true"
                       Format="yyyy-MM-dd HH:mm"
                       Style="width: 100%;"
                       Placeholder=@("Select meeting date and time") />
        </FormItem>

        <FormItem Label="Duration (minutes)">
            <AntDesign.InputNumber @bind-Value=@_meetingForm.Duration
                        Min="15"
                        Max="480"
                        Step="15"
                        Style="width: 100%;"
                        Placeholder="Meeting duration in minutes" />
        </FormItem>

        <FormItem Label="Attendees">
            <Select @bind-Values=@_selectedMemberIds
                    Mode=@SelectMode.Multiple
                    TItemValue="string"
                    TItem="string"
                    Style="width: 100%;"
                    Placeholder="Select meeting attendees"
                    MaxTagCount="3">
                <SelectOptions>
                    @foreach (var member in BoardMembers)
                    {
                        var user = AllUsers.FirstOrDefault(u => u.Id == member.UserId);
                        if (user != null)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value=@user.Id Label=@($"{user.Username} ({user.Email})") />
                        }
                    }
                </SelectOptions>
            </Select>
        </FormItem>

    </Form>
</Modal>