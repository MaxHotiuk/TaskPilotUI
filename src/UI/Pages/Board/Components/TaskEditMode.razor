@using AntDesign
@using Microsoft.AspNetCore.Components.Forms
@using UI.Models.Task
@using UI.Models.State
@using UI.Models.Member
@using UI.Models.User

<Form Model=@FormModel
      LabelCol="new ColLayoutParam { Span = 6 }"
      WrapperCol="new ColLayoutParam { Span = 18 }"
      OnFinish=@OnFormSubmit
      OnFinishFailed=@OnFormSubmitFailed>

    <FormItem Label="Task Title" Required>
        <Input @bind-Value=@FormModel.Title
               Placeholder="Enter task title" 
               MaxLength="200" />
    </FormItem>

    <FormItem Label="Description">
        <TextArea @bind-Value=@FormModel.Description
                  Placeholder="Enter task description (optional)"
                  Rows="4"
                  MaxLength="1000" />
    </FormItem>

    <FormItem Label="State" Required>
        <Select @bind-Value=@FormModel.StateId 
                TItemValue="int" 
                TItem="int" 
                Style="width: 100%;" 
                Placeholder="Select state">
            <SelectOptions>
                @foreach (var state in States)
                {
                    <SelectOption TItemValue="int" TItem="int" Value=@state.Id Label=@state.Name />
                }
            </SelectOptions>
        </Select>
    </FormItem>

    @if (CanManageTask)
    {
        <FormItem Label="Assignee">
            <Select @bind-Value=@FormModel.AssigneeId 
                    TItemValue="string" 
                    TItem="string" 
                    Style="width: 100%;" 
                    Placeholder="Select assignee (optional)"
                    AllowClear=@true>
                <SelectOptions>
                    @foreach (var member in BoardMembers)
                    {
                        var user = AllUsers.FirstOrDefault(u => u.Id == member.UserId);
                        if (user != null)
                        {
                            <SelectOption TItemValue="string" TItem="string" Value=@user.Id Label=@($"{user.Username} ({user.Email})") />
                        }
                    }
                </SelectOptions>
            </Select>
        </FormItem>
    }

    <FormItem Label="Due Date">
        <Input @bind-Value=@DueDateString
               Type=@InputType.Date
               Style="width: 100%;"
               Placeholder="Select due date (optional)" />
    </FormItem>

    <FormItem Label="Priority" Required>
        <Select @bind-Value=@FormModel.Priority TItemValue="int" TItem="int" Style="width: 100%;" Placeholder="Select priority">
            <SelectOptions>
                <SelectOption TItemValue="int" TItem="int" Value="1" Label="Low" />
                <SelectOption TItemValue="int" TItem="int" Value="2" Label="Normal" />
                <SelectOption TItemValue="int" TItem="int" Value="3" Label="High" />
                <SelectOption TItemValue="int" TItem="int" Value="4" Label="Immediate" />
            </SelectOptions>
        </Select>
    </FormItem>

    <FormItem Label="Tag">
        <Select @bind-Value=@FormModel.TagId TItemValue="int?" TItem="int?" Style="width: 100%;" Placeholder="Select tag (optional)">
            <SelectOptions>
                <SelectOption TItemValue="int?" TItem="int?" Value=null Label="No tag" />
                @if (Tags != null)
                {
                    foreach (var tag in Tags)
                    {
                        <SelectOption TItemValue="int?" TItem="int?" Value=@tag.Id Label=@tag.Name />
                    }
                }
            </SelectOptions>
        </Select>
    </FormItem>

</Form>
