@using AntDesign
@using UI.Models.Board
@using UI.Models.Member
@using UI.Models.User

<Modal Title="@UI.Resources.I18n.BoardMembersTitle"
       Visible=@IsVisible
       OnCancel=@OnCancel
       Footer="null"
       Width="800">
    <div style="margin-bottom: 16px;">
        <Button Type=@ButtonType.Primary
                Icon="plus"
                OnClick="OnAddMember">
            @UI.Resources.I18n.AddMemberButton
        </Button>
    </div>
    
    @if (BoardDetail?.Members.Any() == true)
    {
        @if (!_usersLoaded)
        {
            <div class="loading-members">
                <Spin />
                <span style="margin-left: 8px;">@UI.Resources.I18n.LoadingMemberDetails</span>
            </div>
        }
        else
        {
            <div class="members-list">
            @foreach (var member in BoardDetail.Members)
            {
                <div class="member-item">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        @if (IsAvatarLoading(member.UserId))
                        {
                            <Avatar Size=AvatarSize.Small>
                                @GetMemberInitials(member.UserId)
                            </Avatar>
                        }
                        else
                        {
                            var avatarUrl = GetAvatarUrl(member.UserId);
                            if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <Avatar Size=AvatarSize.Small Src=@avatarUrl />
                            }
                            else
                            {
                                <Avatar Size=AvatarSize.Small>
                                    @GetMemberInitials(member.UserId)
                                </Avatar>
                            }
                        }
                        <div>
                            <strong>@GetMemberName(member.UserId)</strong>
                            @if (!string.IsNullOrEmpty(GetMemberEmail(member.UserId)))
                            {
                                <div class="member-email">@GetMemberEmail(member.UserId)</div>
                            }
                            <div class="member-info">
                                @member.Role • Joined @FormatDate(member.CreatedAt)
                            </div>
                        </div>
                    </div>
                    @if (CanManageMembers && member.UserId != CurrentUserId)
                    {
                        <Space>
                            <SpaceItem>
                                <Button Size=@ButtonSize.Small 
                                        OnClick=@(() => OnChangeRole.InvokeAsync((member, "Member")))>
                                    @UI.Resources.I18n.MakeMember
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button Size=@ButtonSize.Small 
                                        OnClick=@(() => OnChangeRole.InvokeAsync((member, "Owner")))>
                                    @UI.Resources.I18n.MakeOwner
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button Danger 
                                        Size=@ButtonSize.Small 
                                        Icon="delete"
                                        OnClick=@(() => OnRemoveMember.InvokeAsync(member))>
                                    @UI.Resources.I18n.RemoveMember
                                </Button>
                            </SpaceItem>
                        </Space>
                    }
                </div>
            }
            </div>
        }
    }
    else
    {
        <div class="no-members">
            <p>@UI.Resources.I18n.NoMembersFound</p>
        </div>
    }
</Modal>
