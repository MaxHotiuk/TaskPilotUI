@using UI.Models.Attachment
@using AntDesign

@if (IsLoading)
{
    <div class="loading-attachments">@UI.Resources.I18n.Loading</div>
}
else if (Attachments?.Any() == true)
{
    <div class="attachments-container">
        <span class="attachments-label">@UI.Resources.I18n.AttachmentsLabel</span>
        <ul class="attachments-list">
            @foreach (var att in Attachments)
            {
                <li class="attachment-item">
                    @if (IsImage(att.FileName))
                    {
                        <span class="attachment-image-preview" @onclick=@(() => ShowImagePreview(att.Url))>
                            <img src=@att.Url alt=@att.FileName class="attachment-image" />
                            <span class="attachment-filename">@att.FileName</span>
                        </span>
                    }
                    else
                    {
                        <a href=@att.Url target="_blank" rel="noopener" class="attachment-link">📎 @att.FileName</a>
                    }
                </li>
            }
        </ul>
    </div>
}

<Modal Title=@UI.Resources.I18n.AttachmentPreviewTitle Visible=@IsPreviewVisible OnCancel="ClosePreview" Footer="null" Width="800">
    @if (!string.IsNullOrEmpty(PreviewImageUrl))
    {
        <img src=@PreviewImageUrl alt=@UI.Resources.I18n.PreviewAlt class="attachment-modal-image" />
    }
</Modal>
