@using AntDesign
@using UI.Models.Board

<Modal Title="@UI.Resources.I18n.ArchiveBoard"
       Visible=@IsVisible
       ConfirmLoading=@IsLoading
       OnOk=@OnOkClicked
       OnCancel=@OnCancelClicked>
    <div class="archive-board-modal-content">
        <p class="archive-warning">@UI.Resources.I18n.ArchiveBoardConfirm</p>
    </div>
</Modal>
