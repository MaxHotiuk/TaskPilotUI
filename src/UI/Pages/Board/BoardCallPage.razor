@page "/board/{BoardId}/meeting/{MeetingId}"
@using AntDesign
@inherits TaskPilotUI.UI.Pages.Board.BoardCallPage

<PageTitle>Board Meeting - @BoardId</PageTitle>

<div class="board-call-container">
    <div class="call-header">
        <Title Level="2" Style="margin: 0; color: #1890ff;">Board Meeting</Title>
        <div class="call-status">
            @if (!_connectionReady)
            {
                <Tag Color=@TagColor.Orange Style="border-radius: 0;">
                    <Icon Type="loading" /> Connecting...
                </Tag>
            }
            else if (_inCall)
            {
                <Tag Color=@TagColor.Green Style="border-radius: 0;">
                    <Icon Type="phone" /> In Call (@_remoteUsers.Count users)
                </Tag>
            }
            else
            {
                <Tag Color=@TagColor.Blue Style="border-radius: 0;">
                    <Icon Type="check-circle" /> Ready
                </Tag>
            }
        </div>
    </div>

    <Divider Style="margin: 20px 0;" />

    <div class="call-controls">
        <Space Size=@SpaceSize.Middle Wrap>
            <Button 
                Type=@(_inCall ? ButtonType.Default : ButtonType.Primary)
                Size=@ButtonSize.Large
                Icon=@(_inCall ? "check" : "phone")
                Disabled=@(!_connectionReady || _inCall)
                OnClick=@StartCall
                Style="border-radius: 0; min-width: 140px;">
                @(_inCall ? "Connected" : "Start Call")
            </Button>
            
            <Button 
                Type=@(_cameraOn ? ButtonType.Primary : ButtonType.Default)
                Size=@ButtonSize.Large
                Icon="video-camera"
                Disabled=@(!_connectionReady)
                OnClick=@ToggleCamera
                Style="border-radius: 0; min-width: 130px;">
                @(_cameraOn ? "Camera On" : "Camera Off")
            </Button>
            
            <Button 
                Type=@(_micOn ? ButtonType.Primary : ButtonType.Default)
                Size=@ButtonSize.Large
                Icon=@(_micOn ? "audio" : "audio-muted")
                Disabled=@(!_connectionReady)
                OnClick=@ToggleMic
                Style="border-radius: 0; min-width: 120px;">
                @(_micOn ? "Mic On" : "Mic Off")
            </Button>
            
            <Button 
                Type=@(_screenSharing ? ButtonType.Primary : ButtonType.Default) 
                Size=@ButtonSize.Large
                Icon=@(_screenSharing ? "desktop" : "laptop")
                Disabled=@(!_connectionReady)
                OnClick=@ToggleScreenShare
                Style="border-radius: 0; min-width: 140px;">
                @(_screenSharing ? "Stop Share" : "Share Screen")
            </Button>
            
            <Button 
                Type=@ButtonType.Primary
                Danger
                Size=@ButtonSize.Large
                Icon="phone"
                Disabled=@(!_inCall)
                OnClick=@HangUp
                Style="border-radius: 0; min-width: 120px;">
                Hang Up
            </Button>
        </Space>
    </div>

    @if (!_inCall)
    {
        <div class="videos-section">
            <Card Title="Video Preview" Style="border-radius: 0;" BodyStyle="padding: 20px;">
                <div class="videos-grid single-video">
                    <Card 
                        Class="video-card local-video" 
                        Style="border-radius: 0; border: 3px solid #1890ff;"
                        BodyStyle="padding: 0; position: relative;">
                        <video id="localVideo" autoplay playsinline muted class="video-element"></video>
                        <div class="video-overlay">
                            <div class="video-info">
                                <Text Strong Style="color: white;">You (Preview)</Text>
                                <div class="video-indicators">
                                    @if (!_cameraOn) 
                                    { 
                                        <Tag Color=@TagColor.Red Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="video-camera" /> OFF
                                        </Tag>
                                    }
                                    @if (!_micOn) 
                                    { 
                                        <Tag Color=@TagColor.Red Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="audio-muted" /> OFF
                                        </Tag>
                                    }
                                    @if (_screenSharing) 
                                    { 
                                        <Tag Color=@TagColor.Green Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="desktop" /> SCREEN
                                        </Tag>
                                    }
                                </div>
                            </div>
                        </div>
                    </Card>
                </div>
                <div style="text-align: center; margin-top: 20px;">
                    <Text Type=@TextElementType.Secondary Style="font-size: 16px;">Click "Start Call" to begin the video conference</Text>
                </div>
            </Card>
        </div>
    }
    else
    {
        <div class="videos-section">
            <Card Title="Video Conference" Style="border-radius: 0;" BodyStyle="padding: 20px;">
                <div class="videos-grid">
                    <Card 
                        Class="video-card local-video" 
                        Style="border-radius: 0; border: 3px solid #1890ff;"
                        BodyStyle="padding: 0; position: relative;">
                        <video id="localVideo" autoplay playsinline muted class="video-element"></video>
                        <div class="video-overlay">
                            <div class="video-info">
                                <Text Strong Style="color: white;">You</Text>
                                <div class="video-indicators">
                                    @if (!_cameraOn) 
                                    { 
                                        <Tag Color=@TagColor.Red Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="video-camera" /> OFF
                                        </Tag>
                                    }
                                    @if (!_micOn) 
                                    { 
                                        <Tag Color=@TagColor.Red Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="audio-muted" /> OFF
                                        </Tag>
                                    }
                                    @if (_screenSharing) 
                                    { 
                                        <Tag Color=@TagColor.Green Style="border-radius: 0; margin-left: 8px;">
                                            <Icon Type="desktop" /> SCREEN
                                        </Tag>
                                    }
                                </div>
                            </div>
                        </div>
                    </Card>

                    @foreach (var user in _remoteUsers)
                    {
                        <Card 
                            Class="video-card remote-video" 
                            Style="border-radius: 0; border: 2px solid #52c41a;"
                            BodyStyle="padding: 0; position: relative;">
                            <video id="@user.VideoId" autoplay playsinline class="video-element"></video>
                            <div class="video-overlay">
                                <div class="video-info">
                                    <Text Strong Style="color: white;">@user.DisplayName</Text>
                                    <div class="video-indicators">
                                        @if (user.ConnectionStatus == "connecting")
                                        {
                                            <Tag Color=@TagColor.Orange Style="border-radius: 0; margin-left: 8px;">
                                                <Icon Type="loading" /> CONNECTING
                                            </Tag>
                                        }
                                        else if (user.ConnectionStatus == "connected")
                                        {
                                            <Tag Color=@TagColor.Green Style="border-radius: 0; margin-left: 8px;">
                                                <Icon Type="check-circle" /> ONLINE
                                            </Tag>
                                        }
                                        else
                                        {
                                            <Tag Color=@TagColor.Red Style="border-radius: 0; margin-left: 8px;">
                                                <Icon Type="disconnect" /> RETRY
                                            </Tag>
                                        }
                                        @if (user.IsScreenSharing)
                                        {
                                            <Tag Color=@TagColor.Purple Style="border-radius: 0; margin-left: 8px;">
                                                <Icon Type="desktop" /> SCREEN
                                            </Tag>
                                        }
                                    </div>
                                </div>
                            </div>
                        </Card>
                    }
                </div>
            </Card>
        </div>
    }
</div>