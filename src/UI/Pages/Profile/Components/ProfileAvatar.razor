@using UI.Models.Avatar

<div class="profile-avatar-card">
    <h3>Avatar</h3>
    <div class="avatar-section">
        <img src=@_avatarUrl alt="Avatar" class="avatar-img" />
        <div class="avatar-actions">
            <label class="avatar-upload-label">
                <InputFile OnChange=@OnFileSelected style="display: none;" accept="image/*" />
                <span class="avatar-upload-btn">Upload New Avatar</span>
            </label>
            @if (_avatarUrl != null)
            {
                <button @onclick=@OnDeleteAvatar class="avatar-delete-btn">Delete Avatar</button>
            }
        </div>
    </div>
</div>
