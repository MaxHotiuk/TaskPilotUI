@page "/welcome"
@using UI.Interfaces.Services
@using UI.Models
@using AntDesign

<PageContainer Title="@UI.Resources.I18n.WelcomeToTaskPilot">
    @if (IsLoading)
    {
        <Card>
            <div style="text-align: center; padding: 40px;">
                <Spin Size=@SpinSize.Large Tip="@UI.Resources.I18n.LoadingUserInformation">
                    <div style="height: 100px;"></div>
                </Spin>
            </div>
        </Card>
    }
    else if (_currentUser != null)
    {
            <Card Title="@UI.Resources.I18n.Dashboard">
            <div style="margin-bottom: 24px;">
                <Alert
                    Message="@UI.Resources.I18n.WelcomeBack"
                    Description=@(string.Format(UI.Resources.I18n.WelcomeLoggedInAs, _currentUser.Username))
                    Type=@AlertType.Success
                    ShowIcon=@true
                    Banner
                    Style="margin-bottom: 24px"/>
            </div>
            
            <Row Gutter="16">
                <AntDesign.Col Span="24" Md="12">
                    <Card Title="@UI.Resources.I18n.UserInformation" Size=@CardSize.Small>
                        <div style="margin-bottom: 16px;">
                            <Text Strong>@UI.Resources.I18n.Username </Text>
                            <Text>@_currentUser.Username</Text>
                        </div>
                        <div style="margin-bottom: 16px;">
                            <Text Strong>@UI.Resources.I18n.Email </Text>
                            <Text>@_currentUser.Email</Text>
                        </div>
                        <div style="margin-bottom: 16px;">
                            <Text Strong>@UI.Resources.I18n.Role </Text>
                            <Tag Color=@(_currentUser.Role == "Admin" ? "red" : "blue")>@_currentUser.Role</Tag>
                        </div>
                        <div style="margin-bottom: 16px;">
                            <Text Strong>@UI.Resources.I18n.MemberSince </Text>
                            <span>@GetFormattedDate(_currentUser.CreatedAt)</span>
                        </div>
                    </Card>
                </AntDesign.Col>
                
                <AntDesign.Col Span="24" Md="12">
                    <Card Title="@UI.Resources.I18n.QuickActions" Size=@CardSize.Small>
                        <Space Direction=@SpaceDirection.Vertical style="width: 100%;" gap="16">
                            <Button Type=@ButtonType.Primary Icon="plus" Size=@ButtonSize.Large Block="true">
                                @UI.Resources.I18n.CreateNewBoard
                            </Button>
                            <Button Icon="team" Size=@ButtonSize.Large Block="true">
                                @UI.Resources.I18n.ViewMyBoards
                            </Button>
                            <Button Icon="user" Size=@ButtonSize.Large Block="true">
                                @UI.Resources.I18n.ProfileSettings
                            </Button>
                        </Space>
                    </Card>
                </AntDesign.Col>
            </Row>
        </Card>
        
        <Card Title=@UI.Resources.I18n.Dashboard Style="margin-top: 24px;">
            <div style="text-align: center; padding: 40px;">
                <Icon Type="inbox" style="font-size: 48px; color: #ccc; margin-bottom: 16px;" />
                <p style="color: #999;">@UI.Resources.I18n.NoRecentActivity</p>
            </div>
        </Card>
        
        <div style="margin-top: 24px; text-align: right;">
            <Button Type=@ButtonType.Default OnClick="HandleLogout">
                @UI.Resources.I18n.Logout
            </Button>
        </div>
    }
    else
    {
        <Card>
            <div style="text-align: center; padding: 40px;">
                <Avatar Size=@AvatarSize.Large Icon="user" style="margin-bottom: 16px;" />
                <Title Level="3">@UI.Resources.I18n.WelcomeToTaskPilot</Title>
                <Paragraph>
                    @UI.Resources.I18n.SignInWithMicrosoftDescription
                </Paragraph>
                <Button Type=@ButtonType.Primary Size=@ButtonSize.Large OnClick="NavigateToLogin">
                    @UI.Resources.I18n.SignIn
                </Button>
            </div>
        </Card>
    }
</PageContainer>
