@page "/"
@page "/boards"
@using AntDesign
@using UI.Models
@using UI.Models.Board
@using UI.Interfaces.Services
@using UI.Pages.Boards.Components
@implements IDisposable

<BoardsPageHeader IsLoading=@IsLoading
                  ShowHeader=@(!IsLoading || _boards.Any())
                  SearchTerm=@_searchTerm
                  SearchTermChanged=@((value) => _searchTerm = value)
                  FilterType=@_filterType
                  OnRefreshClicked=@RefreshBoards
                  OnCreateClicked=@ShowCreateModal
                  OnSearchChanged=@OnSearchChanged
                  OnFilterChanged=@OnFilterChanged />

<div class="boards-content">
    @if (IsLoading && !_boards.Any())
    {
        <div class="loading-container">
            <Spin Size=@SpinSize.Large Tip="Loading your boards...">
                <div style="height: 200px;"></div>
            </Spin>
        </div>
    }
    else if (_boards.Any())
    {
        <div class="boards-grid-container">
            <Row Gutter="(16, 16)" Style="margin-top: 24px;">
                @foreach (var board in _boards)
                {
                    <AntDesign.Col Xxl="6" Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <BoardSearchCard Board=@board
                                        IsOwner=@IsCurrentUserOwner(board.OwnerId)
                                        OnBoardClick=@HandleBoardClick
                                        OnEditBoard=@HandleEditBoard
                                        OnDeleteBoard=@HandleDeleteBoard />
                    </AntDesign.Col>
                }
            </Row>
            
            @if (_hasMoreData)
            {
                <div class="load-more-container">
                    <Button Type=@ButtonType.Default
                            Size=@ButtonSize.Large
                            Loading=@_isSearching
                            OnClick=@LoadMoreBoards
                            Block=@false
                            Style="margin-top: 24px; min-width: 150px;">
                        <Icon Type="down" Style="margin-right: 8px;" />
                        Load More Boards
                    </Button>
                </div>
            }
            
            @if (_isSearching && _boards.Any())
            {
                <div class="loading-more-container">
                    <Spin Size=@SpinSize.Small Tip="Loading more boards...">
                        <div style="height: 50px;"></div>
                    </Spin>
                </div>
            }
        </div>
    }
    else if (!IsLoading && !_isSearching)
    {
        <div class="empty-state-container">
            <Empty Description=@GetEmptyDescription()
                   Style="margin-top: 60px;">
                <ChildContent>
                    @if (!_boards.Any() && string.IsNullOrWhiteSpace(_searchTerm) && _filterType == "all")
                    {
                        <Space Direction=@SpaceDirection.Vertical Size=@SpaceSize.Middle>
                            <SpaceItem>
                                <Button Type=@ButtonType.Primary
                                        Size=@ButtonSize.Large
                                        Icon="plus" 
                                        OnClick=@ShowCreateModal>
                                    Create Your First Board
                                </Button>
                            </SpaceItem>
                        </Space>
                    }
                    else
                    {
                        <Space>
                            <SpaceItem>
                                <Button Type=@ButtonType.Default OnClick=@ClearFilters>
                                    Clear Filters
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button Type=@ButtonType.Primary
                                        Icon="plus" 
                                        OnClick=@ShowCreateModal>
                                    Create New Board
                                </Button>
                            </SpaceItem>
                        </Space>
                    }
                </ChildContent>
            </Empty>
        </div>
    }
</div>

<CreateBoardModal @bind-Visible=@_showCreateModal
                  OnBoardCreated=@HandleBoardCreated />

<DeleteBoardModal @bind-Visible=@_showDeleteModal
                  SelectedBoard=@_selectedBoard
                  IsDeleting=@_isDeleting
                  @bind-DeleteConfirmation=@_deleteConfirmation
                  OnConfirmDelete=@ConfirmDelete
                  OnCancelDelete=@CancelDelete />