@using AntDesign
@using UI.Models
@using UI.Interfaces.Services

<Modal Title="@UI.Resources.I18n.CreateNewBoard"
       Visible=@Visible
       OnOk=@HandleOk
       OnCancel=@HandleCancel
       ConfirmLoading=@_isLoading
       OkText=@UI.Resources.I18n.CreateBoardOk
       CancelText=@UI.Resources.I18n.Cancel
       Width="500">
    
    <Form Model=@_formModel
          Layout=@FormLayout.Vertical
          OnFinish=@HandleSubmit
          OnFinishFailed=@HandleSubmitFailed>
        
        <FormItem Label=@UI.Resources.I18n.BoardNameLabel Required>
            <Input @bind-Value=@_formModel.Name
                   Placeholder=@UI.Resources.I18n.EnterBoardName
                   MaxLength="100" />
        </FormItem>
        
        <FormItem Label=@UI.Resources.I18n.DescriptionLabel>
            <TextArea @bind-Value=@_formModel.Description
                      Placeholder=@UI.Resources.I18n.EnterBoardDescription
                      Rows="3"
                      MaxLength="500" />
        </FormItem>
        
        @if (!string.IsNullOrEmpty(_error))
        {
            <Alert Type=@AlertType.Error 
                   Message=@_error
                   ShowIcon=@true
                   Closable=@true
                   OnClose=@(() => _error = string.Empty)
                   Style="margin-bottom: 16px;" />
        }
    </Form>
</Modal>
