@using AntDesign
@using UI.Models.Board

@if (SelectedBoard != null)
{
    <Modal Title=@($"{UI.Resources.I18n.DeleteBoardTitle}: {SelectedBoard.Name}")
           Visible=@Visible
           OnOk=@ConfirmDelete
           OnCancel=@CancelDelete
           OkText=@UI.Resources.I18n.DeleteTask
           CancelText=@UI.Resources.I18n.Cancel
           ConfirmLoading=@IsDeleting>
        
        <Alert Type=@AlertType.Warning
               ShowIcon=@true
               Style="margin-bottom: 16px;">
            <MessageTemplate>
                <strong>@UI.Resources.I18n.DeleteBoardWarning</strong>
            </MessageTemplate>
            <ChildContent>
                @UI.Resources.I18n.DeleteBoardDescription
            </ChildContent>
        </Alert>
        
        <div style="margin-bottom: 16px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 500;">
                @UI.Resources.I18n.BoardNameLabel:
            </label>
            <Input Value="@DeleteConfirmation"
                   ValueChanged="@DeleteConfirmationChanged"
                   ValueExpression="() => DeleteConfirmation"
                   OnInput="HandleInput"
                   Placeholder=@SelectedBoard.Name />
        </div>
    </Modal>
}
