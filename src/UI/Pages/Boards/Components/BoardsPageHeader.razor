@using AntDesign

<PageHeader Title="@UI.Resources.I18n.MyBoardsTitle">
    <PageHeaderExtra>
        <Space>
            <SpaceItem>
                <Button Type=@ButtonType.Default
                        Icon="reload" 
                        Loading=@IsLoading
                        OnClick=@OnRefreshClicked>
                    @UI.Resources.I18n.Refresh
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type=@ButtonType.Primary
                        Icon="plus" 
                        OnClick=@OnCreateClicked>
                    @UI.Resources.I18n.CreateBoard
                </Button>
            </SpaceItem>
        </Space>
    </PageHeaderExtra>
    
    <PageHeaderContent>
        @if (ShowHeader)
        {
            <BoardsHeader SearchTermChanged=@SearchTermChanged
                          FilterType="FilterType"
                          OnSearchChanged=@OnSearchChanged
                          OnFilterChanged=@OnFilterChanged />
        }
    </PageHeaderContent>
</PageHeader>
