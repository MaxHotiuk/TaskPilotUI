@using AntDesign
@using UI.Models.Organization
@using UI.Interfaces.Services

<Modal Title="@UI.Resources.I18n.RejectManagerRequest"
       Visible="@Visible"
       OnOk="@HandleOk"
       OnCancel="@HandleCancel"
       ConfirmLoading="@_isLoading"
       OkText="@UI.Resources.I18n.Reject"
       CancelText="@UI.Resources.I18n.Cancel"
       Width="600"
       OkButtonProps="new ButtonProps { Danger = true }">

    @if (Request != null)
    {
        <Form Model="@_formModel"
              Layout="@FormLayout.Vertical"
              OnFinish="@HandleSubmit">

            <Alert Type="@AlertType.Warning"
                   Message="@($"{UI.Resources.I18n.RejectingRequestFrom} {Request.UserName}")"
                   ShowIcon="@true"
                   Style="margin-bottom: 16px;" />

            <FormItem Label="@UI.Resources.I18n.RejectionNotes">
                <TextArea @bind-Value="@_formModel.ReviewNotes"
                          Placeholder="@UI.Resources.I18n.OptionalRejectionReason"
                          Rows="4"
                          MaxLength="500"
                          ShowCount="@true" />
            </FormItem>

            @if (!string.IsNullOrEmpty(_error))
            {
                <Alert Type="@AlertType.Error"
                       Message="@_error"
                       ShowIcon="@true"
                       Closable="@true"
                       OnClose="@(() => _error = string.Empty)"
                       Style="margin-bottom: 16px;" />
            }
        </Form>
    }
</Modal>
